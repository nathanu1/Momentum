generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  applications  Application[]
  tasks         Task[]
  habits        Habit[]
  weeklyReviews WeeklyReview[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Application {
  id                 String   @id @default(cuid())
  userId             String
  company            String
  role               String
  location           String?
  link               String?
  status             String   // Wishlist, Applied, OA, Interview, Offer, Rejected
  dateApplied        DateTime?
  nextFollowUpDate   DateTime?
  notes              String?
  resumeVersion      String?
  coverLetterVersion String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  dueDate     DateTime?
  priority    String   @default("Medium") // Low, Medium, High
  status      String   @default("Todo") // Todo, In Progress, Done
  category    String   // Career, School, Health, Personal, Admin
  isRecurring Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Habit {
  id          String   @id @default(cuid())
  userId      String
  name        String
  frequency   String   // Daily, Weekly
  category    String   // Health, Productivity, Mindset, Personal Care
  streak      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs        HabitLog[]
}

model HabitLog {
  id          String   @id @default(cuid())
  habitId     String
  date        DateTime // Store the date the habit was completed
  completed   Boolean  @default(true)
  createdAt   DateTime @default(now())

  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date]) // Ensure one log per day/week per habit
}

model WeeklyReview {
  id                   String   @id @default(cuid())
  userId               String
  weekStartDate        DateTime
  weekEndDate          DateTime
  wins                 String?
  challenges           String?
  applicationsSubmitted Int      @default(0)
  tasksCompleted       Int      @default(0)
  habitsConsistency    Float    @default(0) // E.g., percentage
  prioritiesNextWeek   String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
